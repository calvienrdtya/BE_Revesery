# ── Server ──
PORT=8000
LOG_LEVEL=INFO

# ── CORS (csv origin FE) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# ── Auth ──
# Kosong = upload publik (dev). Isi = wajib header "X-API-Key: <nilai>" (production).
API_KEY=

# ── Storage ──
# Folder persist hasil pipeline + xlsx terakhir. Mount sebagai volume di Docker.
DATA_DIR=./data

# ── Upload ──
MAX_UPLOAD_MB=50

# ── ML knobs ──
CHURN_DAYS=60
MULTIBULAN_CUTOFF=2026-03-07
